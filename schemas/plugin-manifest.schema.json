{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luxeron.dev/polar-pyro/schemas/plugin-manifest-v1.json",
  "title": "Polar Pyro Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "name", "kind", "publisher", "license", "source", "transport", "capabilities"],
  "properties": {
    "schema_version": {"const": "polar.plugin/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 100},
    "kind": {"enum": ["ui", "service", "engine", "bridge", "composite"]},
    "publisher": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {"repository": {"type": "string"}, "commit": {"type": "string", "minLength": 7}, "upstream": {"type": "string"}}
    },
    "transport": {
      "type": "object", "required": ["kind"],
      "properties": {"kind": {"enum": ["mcp_stdio", "mcp_http", "http", "native", "iframe"]}, "command": {"type": "array", "items": {"type": "string"}}, "endpoint": {"type": "string"}}
    },
    "capabilities": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "effect", "input_schema", "output_schema"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"},
          "effect": {"enum": ["observe", "workspace_write", "external_write", "credential", "value_transfer"]},
          "input_schema": {"type": "object"}, "output_schema": {"type": "object"},
          "required_grants": {"type": "array", "items": {"type": "string"}},
          "evidence_classes": {"type": "array", "items": {"type": "string"}},
          "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 3600000}
        }
      }
    },
    "contributions": {"type": "array", "items": {"type": "object"}},
    "compatibility": {"type": "object"}
  }
}

