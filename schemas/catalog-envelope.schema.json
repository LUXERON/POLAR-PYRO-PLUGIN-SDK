{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.luxeron.dev/polar/catalog-envelope.schema.json",
  "title": "Polar Pyro signed plugin catalog envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "algorithm", "key_id", "payload", "signature"],
  "properties": {
    "schema_version": {"const": "polar.catalog-envelope/v1"},
    "algorithm": {"const": "Ed25519"},
    "key_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "signature": {"type": "string", "contentEncoding": "base64"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issued_at", "expires_at", "plugins"],
      "properties": {
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "plugins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["plugin_id", "version", "manifest_digest", "package_tree_sha256", "artifact_uri"],
            "properties": {
              "plugin_id": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "manifest_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "package_tree_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "artifact_uri": {"type": "string", "format": "uri"}
            }
          }
        }
      }
    }
  }
}
