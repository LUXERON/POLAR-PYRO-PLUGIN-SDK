{
  "schema_version": "polar.plugin/v1",
  "id": "dev.luxeron.adapter.obscura",
  "version": "0.1.0",
  "name": "Obscura Browser Adapter",
  "kind": "bridge",
  "publisher": "LUXERON",
  "license": "Apache-2.0",
  "source": {"repository": "https://github.com/LUXERON/POLAR-PYRO-OBSCURA-PLUGIN", "commit": "0000000", "upstream": "h4ckf0r0day/obscura@5465ff76abde560c7e9d69b1ca85895562de38e4"},
  "transport": {"kind": "mcp_stdio", "command": ["obscura-mcp"]},
  "capabilities": [
    {
      "id": "browser.snapshot",
      "effect": "observe",
      "input_schema": {"type": "object", "additionalProperties": false, "required": ["url"], "properties": {"url": {"type": "string"}}},
      "output_schema": {"type": "object", "required": ["url", "snapshot"], "properties": {"url": {"type": "string"}, "snapshot": {"type": "string"}}},
      "evidence_classes": ["browser.snapshot"],
      "timeout_ms": 60000
    }
  ],
  "contributions": [],
  "compatibility": {"host_api": ">=1.0 <2.0", "private_network_default": "deny", "file_access_default": "deny"}
}

