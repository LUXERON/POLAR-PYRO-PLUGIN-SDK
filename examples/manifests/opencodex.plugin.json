{
  "schema_version": "polar.plugin/v1",
  "id": "dev.luxeron.bridge.opencodex",
  "version": "0.1.0",
  "name": "Polar OpenCodex Compatibility Edge",
  "kind": "bridge",
  "publisher": "LUXERON",
  "license": "MIT",
  "source": {"repository": "https://github.com/LUXERON/POLAR-OPENCODEX-BRIDGE", "commit": "0000000", "upstream": "lidge-jun/opencodex@5840591322117f3ee9568b35b135a6d4339f7711"},
  "transport": {"kind": "http", "endpoint": "http://127.0.0.1:10100"},
  "capabilities": [
    {
      "id": "compat.compile_request",
      "effect": "observe",
      "input_schema": {"type": "object", "required": ["protocol", "request"], "properties": {"protocol": {"enum": ["openai-responses", "anthropic-messages"]}, "request": {"type": "object"}}},
      "output_schema": {"type": "object", "required": ["session_id", "response"], "properties": {"session_id": {"type": "string"}, "response": {"type": "object"}}},
      "evidence_classes": ["intent.receipt", "oracle.certificate"]
    }
  ],
  "contributions": [{"slot": "settings.integration", "label": "Codex / Claude compatibility", "entry": "/plugins/opencodex/settings"}],
  "compatibility": {"host_api": ">=1.0 <2.0", "bind_default": "loopback", "enable_default": false}
}

