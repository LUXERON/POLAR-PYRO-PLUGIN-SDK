{
  "schema_version": "polar.plugin/v1",
  "id": "dev.luxeron.polar.browser",
  "version": "0.1.0",
  "name": "Polar Browser",
  "kind": "composite",
  "publisher": "LUXERON",
  "license": "MIT",
  "source": {"repository": "https://github.com/LUXERON/POLAR-PYRO-BROWSER", "commit": "0000000"},
  "transport": {"kind": "mcp_http", "endpoint": "http://127.0.0.1:8794/mcp"},
  "capabilities": [
    {
      "id": "browser.navigate",
      "effect": "observe",
      "input_schema": {"type": "object", "additionalProperties": false, "required": ["url"], "properties": {"url": {"type": "string", "minLength": 1}}},
      "output_schema": {"type": "object", "required": ["url", "title"], "properties": {"url": {"type": "string"}, "title": {"type": "string"}}},
      "evidence_classes": ["browser.snapshot"],
      "timeout_ms": 30000
    }
  ],
  "contributions": [{"slot": "session.tab", "label": "Browser", "entry": "/plugins/browser"}],
  "compatibility": {"host_api": ">=1.0 <2.0"}
}

