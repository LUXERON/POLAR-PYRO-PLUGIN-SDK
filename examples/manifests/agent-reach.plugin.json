{
  "schema_version": "polar.plugin/v1",
  "id": "dev.luxeron.adapter.agent-reach",
  "version": "0.1.0",
  "name": "Agent Reach Channel Adapter",
  "kind": "bridge",
  "publisher": "LUXERON",
  "license": "MIT",
  "source": {"repository": "https://github.com/LUXERON/POLAR-PYRO-AGENT-REACH-PLUGIN", "commit": "3771a2c86b0fea6f387a2b6ce3af3edcbf1260a0", "upstream": "Panniantong/Agent-Reach@93ae1d18c37b707dec053c7c4f9d91cd8ef8943d"},
  "transport": {"kind": "native"},
  "capabilities": [
    {
      "id": "reach.route_public_channel",
      "effect": "observe",
      "input_schema": {"type": "object", "additionalProperties": false, "required": ["url"], "properties": {"url": {"type": "string"}}},
      "output_schema": {"type": "object", "required": ["channel", "items"], "properties": {"channel": {"type": "string"}, "items": {"type": "array", "items": {"type": "object"}}}},
      "evidence_classes": ["channel.route"]
    }
  ],
  "contributions": [],
  "compatibility": {"host_api": ">=1.0 <2.0", "personal_profile_default": "deny", "install_tools_default": "deny", "downstream_backends": "independently_registered"}
}
