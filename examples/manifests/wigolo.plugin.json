{
  "schema_version": "polar.plugin/v1",
  "id": "dev.luxeron.adapter.wigolo",
  "version": "0.1.0",
  "name": "Wigolo Retrieval Adapter",
  "kind": "bridge",
  "publisher": "LUXERON",
  "license": "AGPL-3.0-only (external-process boundary)",
  "source": {"repository": "https://github.com/LUXERON/POLAR-WIGOLO-PLUGIN", "commit": "0000000", "upstream": "KnockOutEZ/wigolo@c6ad4479da7706945b479786df0121e3cce1ece6"},
  "transport": {"kind": "mcp_stdio", "command": ["wigolo"]},
  "capabilities": [
    {
      "id": "retrieval.search_evidence",
      "effect": "observe",
      "input_schema": {"type": "object", "additionalProperties": false, "required": ["query"], "properties": {"query": {"type": "string", "minLength": 1}, "max_items": {"type": "integer"}}},
      "output_schema": {"type": "object", "required": ["evidence"], "properties": {"evidence": {"type": "array", "items": {"type": "object"}}}},
      "evidence_classes": ["web.source_span", "web.citation"]
    }
  ],
  "contributions": [],
  "compatibility": {"host_api": ">=1.0 <2.0", "distribution": "separate-service"}
}

